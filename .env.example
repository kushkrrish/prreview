# Environment
ENVIRONMENT=development

# Database (Tiger Cloud)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=256
OPENAI_REVIEW_MODEL=gpt-4.1-mini
GEMINI_REVIEW_MODEL=gemini-3.6-flash
GEMINI_MAX_INPUT_TOKENS=100000
GROQ_API_KEY=gsk_...
GROQ_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_MAX_INPUT_TOKENS=7000

# GitHub
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your-secret-here
GITHUB_PRIVATE_KEY_PATH=./github-key.pem

# Redis/Queue
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

